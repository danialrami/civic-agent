# Your home address (used for Google Civic API queries)
# Example: "123 Main St, San Antonio, TX 78201"
CIVIC_ADDRESS=your_address_here

# Google Civic Information API Key
# Get from: https://console.cloud.google.com/apis/credentials
# Instructions:
# 1. Go to Google Cloud Console > APIs & Services > Credentials
# 2. Create Project (if needed) and enable "Civic Information API"
# 3. Create Credentials > API Key
# 4. (Optional) Restrict the key to only allow Civic Information API calls
# Note: This API uses API keys only (no OAuth/client ID needed for public election data)
GOOGLE_CIVIC_API_KEY=your_api_key_here
